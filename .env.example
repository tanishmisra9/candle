# Copy to .env at the repo root. The backend reads it; the frontend reads the VITE_* values at build time.
# Local Postgres (docker compose) is published on host port 5433.
DATABASE_URL=postgresql+asyncpg://candle:candle@localhost:5433/candle
# development | production. Production refuses to start with the default DATABASE_URL and treats a missing pg_trgm as fatal.
DEPLOYMENT_ENV=development
# Required for Ask, embeddings and AI summaries/overviews.
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-4.1-mini
# Fast model that short-circuits greetings/distress/advice/out-of-scope questions before retrieval.
INTENT_CLASSIFIER_MODEL=gpt-4.1-nano
# Optional: enables the Cohere rerank step in Ask. Empty = skip rerank.
COHERE_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173
# Only true behind a real reverse proxy that sets X-Forwarded-For (it keys the per-IP rate limit).
TRUST_PROXY_HEADERS=false
CLINICAL_TRIALS_BASE_URL=https://clinicaltrials.gov/api/v2/studies
PUBMED_SEARCH_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi
PUBMED_FETCH_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi
# NCBI asks API clients to identify themselves; use a real contact in production.
NCBI_USER_AGENT=Candle/1.0 (+https://localhost; local research app)
VITE_API_BASE_URL=http://localhost:8000
